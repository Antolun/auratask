    def _setup_shortcuts(self):
        """Register global keyboard shortcuts for the main window."""
        # Space -> toggle Pomodoro start/pause (only when no text widget focused)
        self._sc_space = QShortcut(QKeySequence(Qt.Key.Key_Space), self)
        self._sc_space.setContext(Qt.ShortcutContext.WindowShortcut)
        self._sc_space.activated.connect(self._shortcut_toggle_timer)

        # Ctrl+N -> Add new task
        self._sc_new = QShortcut(QKeySequence("Ctrl+N"), self)
        self._sc_new.activated.connect(lambda: self.on_add_task("todo"))

        # Ctrl+1..5 -> Switch tabs
        for i in range(1, 6):
            sc = QShortcut(QKeySequence(f"Ctrl+{i}"), self)
            sc.activated.connect(lambda idx=i-1: self.tab_widget.setCurrentIndex(idx))

        # Ctrl+Alt+C -> Archive done tasks
        self._sc_archive = QShortcut(QKeySequence("Ctrl+Alt+C"), self)
        self._sc_archive.activated.connect(self.on_clear_completed)

    def _shortcut_toggle_timer(self):
        """Space toggles Pomodoro start/pause if no text input is focused."""
        from PyQt6.QtWidgets import QLineEdit, QTextEdit
        focused = QApplication.focusWidget()
        if isinstance(focused, (QLineEdit, QTextEdit)):
            return  # Don't steal space from text fields
        pw = self.pomodoro_widget
        if pw.is_running:
            pw.pause_timer()
        else:
            pw.start_timer()

    def _on_theme_changed(self, index):
        """Apply and persist the newly selected theme."""
        theme_key = self.theme_combo.currentData()
        if not theme_key:
            return
        set_active_theme(theme_key)
        self.db.set_theme(theme_key)
        # Re-apply stylesheet to the application
        QApplication.instance().setStyleSheet(get_stylesheet())
        # Force repaint of all custom-painted widgets
        self.refresh_stats()
        self.refresh_columns()

    def _on_donut_mode_changed(self, index):
        """Switch DonutChartWidget between priority and tag-focus modes."""
        mode = self.donut_mode_combo.currentData()
        if mode == "tags":
            self.donut_title_lbl.setText(Localization.get("donut_tag_focus"))
            self.donut_widget.set_mode("tags")
        else:
            self.donut_title_lbl.setText(Localization.get("donut_task_dist"))
            self.donut_widget.set_mode("priority")

