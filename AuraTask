    def export_json(self):
        import json as _json
        path, _ = QFileDialog.getSaveFileName(
            self, Localization.get("export_json_dialog_title"), "auratask_backup.json",
            Localization.get("export_json_filter")
        )
        if not path:
            return
        try:
            data = self.db.data
            with open(path, "w", encoding="utf-8") as f:
                _json.dump(data, f, ensure_ascii=False, indent=4)
            QMessageBox.information(self, Localization.get("export_success_title"), Localization.get("export_json_success", path))
        except Exception as e:
            QMessageBox.critical(self, Localization.get("export_error_title"), Localization.get("export_json_error", str(e)))

    def export_csv(self):
        import csv as _csv
        path, _ = QFileDialog.getSaveFileName(
            self, Localization.get("export_csv_dialog_title"), "auratask_tasks.csv",
            Localization.get("export_csv_filter")
        )
        if not path:
            return
        try:
            tasks = self.db.get_tasks()
            with open(path, "w", encoding="utf-8", newline="") as f:
                writer = _csv.writer(f)
                writer.writerow([
                    Localization.get("csv_header_id"),
                    Localization.get("csv_header_title"),
                    Localization.get("csv_header_desc"),
                    Localization.get("csv_header_priority"),
                    Localization.get("csv_header_status"),
                    Localization.get("csv_header_tags"),
                    Localization.get("csv_header_due"),
                    Localization.get("csv_header_focus"),
                    Localization.get("csv_header_created")
                ])
                for t in tasks:
                    writer.writerow([
                        t.get("id", ""),
                        t.get("title", ""),
                        t.get("description", ""),
                        t.get("priority", ""),
                        t.get("status", ""),
                        ", ".join(t.get("tags", [])),
                        t.get("due_date", ""),
                        t.get("focus_time", 0),
                        t.get("created_at", "")
                    ])
            QMessageBox.information(self, Localization.get("export_success_title"), Localization.get("export_csv_success", path))
        except Exception as e:
            QMessageBox.critical(self, Localization.get("export_error_title"), Localization.get("export_csv_error", str(e)))

    def import_json(self):
        import json as _json
        path, _ = QFileDialog.getOpenFileName(
            self, Localization.get("import_json_dialog_title"), "",
            Localization.get("import_json_filter")
        )
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8") as f:
                imported = _json.load(f)

            if "tasks" not in imported:
                QMessageBox.warning(self, Localization.get("warning"), Localization.get("import_invalid_warning"))
                return

            reply = QMessageBox.question(
                self, Localization.get("import_confirm_title"),
                Localization.get("import_confirm_msg", len(imported['tasks'])),
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No
            )
            if reply != QMessageBox.StandardButton.Yes:
                return

            # Merge tasks - avoid duplicates by ID
            existing_ids = {t["id"] for t in self.db.data["tasks"]}
            added = 0
            for task in imported["tasks"]:
                if task.get("id") not in existing_ids:
                    self.db.data["tasks"].append(task)
                    added += 1

            self.db.save_data()
            self.refresh_all()
            QMessageBox.information(self, Localization.get("export_success_title"), Localization.get("import_success", added))
        except Exception as e:
            QMessageBox.critical(self, Localization.get("export_error_title"), Localization.get("import_error", str(e)))


SINGLE_INSTANCE_KEY = "auratask_single_instance"


class SingleInstanceApp(QApplication):
    """Uygulama zaten çalışıyorsa mevcut pencereyi ön plana getirir,
    aksi hâlde normal şekilde başlar."""

    def __init__(self, argv):
        super().__init__(argv)
        self._server = None
        self._window = None

    def is_already_running(self):
        """Çalışan bir örnek varsa ona sinyal gönderir ve True döner."""
        socket = QLocalSocket()
        socket.connectToServer(SINGLE_INSTANCE_KEY)
        if socket.waitForConnected(500):
            # Çalışan örneğe 'show' mesajı gönder
            socket.write(b"show")
            socket.flush()
            socket.waitForBytesWritten(500)
            socket.disconnectFromServer()
            return True
        return False

    def start_server(self, window):
        """Bu örnek birincil; IPC sunucusunu başlat."""
        self._window = window
        # Çakışan eski sunucu kalıntılarını temizle
        QLocalServer.removeServer(SINGLE_INSTANCE_KEY)
        self._server = QLocalServer(self)
        self._server.newConnection.connect(self._on_new_connection)
        self._server.listen(SINGLE_INSTANCE_KEY)

    def _on_new_connection(self):
        conn = self._server.nextPendingConnection()
        conn.readyRead.connect(lambda: self._handle_message(conn))

    def _handle_message(self, conn):
        msg = conn.readAll().data()
        conn.disconnectFromServer()
        if b"show" in msg and self._window:
            self._window.show_and_restore()


def main():
    app = SingleInstanceApp(sys.argv)

    # Zaten çalışıyorsa mevcut örneği ön plana getir ve çık
    if app.is_already_running():
        sys.exit(0)

    # Check for --minimized flag (used by autostart)
    start_minimized = "--minimized" in sys.argv

    # MainWindow loads the saved theme in __init__ before get_stylesheet() is called
    window = MainWindow()
    # Now apply the correct stylesheet (theme already set by MainWindow.__init__)
    app.setStyleSheet(get_stylesheet())
    app.start_server(window)

    if start_minimized:
        # Start hidden; tray icon is already visible from __init__
        window.hide()
    else:
        window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
