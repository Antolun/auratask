    # ==========================================
    # AUTOSTART HELPERS
    # ==========================================
    def _get_autostart_desktop_path(self):
        """Return the XDG autostart .desktop file path for AuraTask."""
        return os.path.join(
            os.path.expanduser("~"), ".config", "autostart", "auratask.desktop"
        )

    def _apply_autostart(self, enabled: bool):
        """Create or remove the XDG autostart desktop entry."""
        path = self._get_autostart_desktop_path()
        if enabled:
            # Find the AuraTask executable
            exec_path = os.path.abspath(__file__)
            icon_path = os.path.join(os.path.dirname(exec_path), "data", "logo.png")
            autostart_dir = os.path.dirname(path)
            os.makedirs(autostart_dir, exist_ok=True)
            content = (
                "[Desktop Entry]\n"
                "Name=AuraTask\n"
                "Comment=Personal Focus & Task Manager\n"
                f"Exec=/usr/bin/python3 {exec_path} --minimized\n"
                f"Icon={icon_path}\n"
                "Terminal=false\n"
                "Type=Application\n"
                "Categories=Office;Utility;Development;\n"
                "X-GNOME-Autostart-enabled=true\n"
                "StartupNotify=false\n"
            )
            try:
                with open(path, "w", encoding="utf-8") as f:
                    f.write(content)
                os.chmod(path, 0o755)
            except Exception as e:
                QMessageBox.warning(self, "Error", f"Could not write autostart file:\n{e}")
        else:
            try:
                if os.path.exists(path):
                    os.remove(path)
            except Exception as e:
                QMessageBox.warning(self, "Error", f"Could not remove autostart file:\n{e}")

    def _on_autostart_toggled(self, checked: bool):
        """Handle autostart checkbox toggle: persist setting and update .desktop file."""
        self.db.set_autostart(checked)
        self._apply_autostart(checked)
        if checked:
            msg = Localization.get("autostart_enabled_msg")
        else:
            msg = Localization.get("autostart_disabled_msg")
        self.tray_icon.showMessage(
            Localization.get("autostart_section_title"),
            msg,
            self.tray_icon.icon(),
            3000
        )

    def show_and_restore(self):
        self.show()
        self.raise_()
        self.activateWindow()

    def quit_application(self):
        self.really_quit = True
        self.close()
        QApplication.quit()

    def on_tray_icon_activated(self, reason):
        if reason in (QSystemTrayIcon.ActivationReason.Trigger, QSystemTrayIcon.ActivationReason.DoubleClick):
            self.show_and_restore()

    def closeEvent(self, event):
        if hasattr(self, 'really_quit') and self.really_quit:
            event.accept()
        elif self.tray_icon.isVisible():
            self.hide()
            self.tray_icon.showMessage(
                Localization.get("app_title"),
                Localization.get("running_in_bg_msg"),
                self.tray_icon.icon(),
                2000
            )
            event.ignore()
        else:
            event.accept()

